<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>naex</name>
  <version>0.0.1</version>
  <description>Robot navigation and exploration.</description>
  <maintainer email="tpetricek@gmail.com">Tomas Petricek</maintainer>
  <maintainer email="vlkjan6@fel.cvut.cz">Jan Vlk</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/tpet/naex</url>
  <author email="tpetricek@gmail.com">Tomas Petricek</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boost</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <!-- map.h and traversability.h use FLANN; its serializer needs liblz4. -->
  <depend>libflann-dev</depend>
  <depend>liblz4-dev</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- grid_planner publishes frontier markers on map_frontiers. -->
  <depend>visualization_msgs</depend>

  <!-- Python nodes (scripts/*.py). -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- ros2_numpy is a source package of this workspace (src/ros2_numpy);
       it is not in the public rosdep index. -->
  <exec_depend>ros2_numpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>tf_transformations</exec_depend>

  <!-- Launch files. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>point_cloud_transport</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
